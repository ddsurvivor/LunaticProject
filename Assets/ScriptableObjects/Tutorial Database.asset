  allTutorials:
  - triggerLevelName: PR0BATTLE-1
    pages:
    - image: {fileID: 21300000, guid: 86be32ee25a32e449b5679a40ffa99b0, type: 3}
      title: "\u6218\u6597\u57FA\u7840"
      description: "\u4F7F\u7528\u9F20\u6807\u5DE6\u952E\u9009\u4E2D\u4EBA\u7269\uFF0C\u5728\u89D2\u8272\u53F3\u4FA7\u7684\u9009\u9879\u680F\u9009\u62E9\u64CD\u4F5C\u5E76\u70B9\u51FB\u9F20\u6807\u5DE6\u952E\u6267\u884C\u3002"
    - image: {fileID: 21300000, guid: 5c5c4e71d1d044a4f9d0c002323b2e8f, type: 3}
      title: "\u6218\u6597\u57FA\u7840"
      description: "\u5F53\u666E\u901A\u653B\u51FB\u6216\u5DF1\u65B9\u627F\u53D7\u4F24\u5BB3\u5230\u4E00\u5B9A\u7A0B\u5EA6\uFF0C\u5373\u53EF\u89E6\u53D1<b>\u201C\u805A\u80FD\u201D</b>\u3002\u4F7F\u7528\u201C\u805A\u80FD\u201D\u4F1A\u4E3A\u6211\u65B9\u961F\u4F0D\u63D0\u4F9B\u989D\u5916\u56DE\u5408\uFF0C\u6211\u65B9\u8F93\u51FA\u4E5F\u5C06\u4F1A\u5927\u5E45\u63D0\u5347\uFF0C\u63D0\u4F9B\u626D\u8F6C\u6218\u5C40\u7684\u673A\u4F1A\u3002"
  - triggerLevelName: PRBossFight
    pages:
    - image: {fileID: 21300000, guid: 3c1440d1c838ef445a9961ea2737ca4f, type: 3}
      title: "\u8F68\u9053\u652F\u63F4"
      description: "\u5728\u7279\u5B9A\u60C5\u51B5\u4E0B\uFF0C\u6211\u65B9\u961F\u4F0D\u80FD\u4F7F\u7528\u8F68\u9053\u652F\u63F4\uFF0C\u901A\u8FC7\u589E\u63F4\u98DE\u8239\u7684\u706B\u529B\u653B\u51FB\u654C\u4EBA\uFF0C\u4EE5\u9020\u6210<b>\u4EBA\u529B\u96BE\u4EE5\u4F01\u53CA</b>\u7684\u4F24\u5BB3\u3002"
    - image: {fileID: 21300000, guid: febf0c188897901448c82a7323c6def0, type: 3}
      title: "\u8F68\u9053\u652F\u63F4"
      description: "\u5728\u89D2\u8272\u62B5\u8FBE<b>\u9732\u5929\u5730\u5F62</b>\u540E\uFF0C\u5373\u53EF\u5BF9\u654C\u4EBA\u5B9E\u65BD\u8F68\u9053\u652F\u63F4\u653B\u51FB\u3002\u5728\u786E\u8BA4\u6253\u51FB\u8303\u56F4\u540E\u7684\u4E0B\u4E2A\u56DE\u5408\uFF0C\u8F68\u9053\u652F\u63F4\u4F1A\u5728\u654C\u65B9\u884C\u52A8\u524D\u51FB\u4E2D\u8303\u56F4\u5185\u7684\u76EE\u6807\u3002"
    - image: {fileID: 21300000, guid: febf0c188897901448c82a7323c6def0, type: 3}
      title: "\u8F68\u9053\u652F\u63F4"
      description: "\u6CE8\u610F\uFF0C\u8F68\u9053\u652F\u63F4\u65E0\u6CD5\u8FDE\u7EED\u53D1\u52A8\uFF0C\u9700\u8981\u7B49\u5F85\u652F\u63F4\u5355\u4F4D\u5B8C\u6210\u4E0B\u4E00\u8F6E\u653B\u51FB\u7684\u51C6\u5907\u3002\u5982\u53D1\u52A8\u653B\u51FB\u65F6\u6709\u53CB\u65B9\u5355\u4F4D\u5904\u4E8E\u653B\u51FB\u8303\u56F4\u5185\uFF0C\u8FD9\u4E9B\u5355\u4F4D\u4E5F\u4F1A\u627F\u53D7\u540C\u6837\u7684\u4F24\u5BB3\u3002"
  - triggerLevelName: C1M1BATTLE
    pages:
    - image: {fileID: 21300000, guid: 1b62d22fc0d32ad4db41fc6cfbec4540, type: 3}
      title: "\u7279\u6B8A\u76EE\u6807"
      description: "\u6709\u65F6\uFF0C\u6218\u6597\u4EFB\u52A1\u4E2D\u4F1A\u51FA\u73B0\u4EE5\u611F\u53F9\u53F7\u6807\u8BC6\u7684\u7279\u6B8A\u76EE\u6807\u3002\u8FD9\u7C7B\u76EE\u6807\u62E5\u6709\u4E0D\u540C\u7684\u884C\u52A8\u6A21\u5F0F\uFF0C\u5F88\u53EF\u80FD\u5DE6\u53F3\u6218\u5C40\u3002"
    - image: {fileID: 21300000, guid: cff01a5273ac7f743b5768f7544b5c47, type: 3}
      title: "\u7279\u6B8A\u76EE\u6807"
      description: "\u5982\u679C\u653E\u4EFB\u7279\u6B8A\u76EE\u6807\u884C\u52A8\uFF0C\u5F53\u5176\u62B5\u8FBE\u7279\u5B9A\u533A\u57DF\uFF0C\u53EF\u80FD\u4F1A\u5F15\u53D1\u4E25\u91CD\u540E\u679C\u3002"
    - image: {fileID: 21300000, guid: afeb6ce2b03e7624c83ee5d77e1c5097, type: 3}
      title: "\u7279\u6B8A\u76EE\u6807"
      description: "\u6CE8\u610F\u5730\u56FE\u4E0A\u7684\u7279\u6B8A\u533A\u57DF\uFF0C\u5E76\u5168\u529B\u963B\u6B62\u7279\u6B8A\u76EE\u6807\u5427\u3002"
  - triggerLevelName: PR1-LVUP
    pages:
    - image: {fileID: 21300000, guid: 3f230619bbd302e4f8d69ceb14b173dd, type: 3}
      title: "\u89D2\u8272\u7B49\u7EA7&\u5206\u914D\u89D2\u8272\u70B9\u6570"
      description: "\u6218\u6597\u548C\u90E8\u5206\u5267\u60C5\u4E8B\u4EF6\u4F1A\u589E\u52A0\u7ECF\u9A8C\u503C\uFF0C\u5F53\u7ECF\u9A8C\u503C\u79EF\u7D2F\u5230\u4E00\u5B9A\u7A0B\u5EA6\uFF0C\u5373\u53EF\u5728\u5927\u5730\u56FE\u83DC\u5355\u5DE6\u4E0B\u89D2\u8FDB\u5165\u7F16\u961F\u754C\u9762\uFF0C\u8FDB\u884C\u5347\u7EA7\u3002"
    - image: {fileID: 21300000, guid: ea0a29bc87f7e9a44baf917934d307c0, type: 3}
      title: "\u89D2\u8272\u7B49\u7EA7&\u89D2\u8272\u70B9\u6570"
      description: "\u60A8\u53EF\u4EE5\u81EA\u884C\u8C03\u6574\u89D2\u8272\u7684\u4E94\u9879\u5C5E\u6027\uFF0C\u8FD9\u4E9B\u8C03\u6574\u4E5F\u4F1A\u53CD\u6620\u5728\u5BF9\u5E94\u7684\u6218\u6597\u5C5E\u6027\u4E0A\u2014\u2014\u8BF7\u4ED4\u7EC6\u659F\u914C\u3002"
  - triggerLevelName: CHAIN-ATTACK
    pages:
    - image: {fileID: 21300000, guid: 911b2078db45d2a44af11e3a13e0b561, type: 3}
      title: "\u8FDE\u9501\u653B\u51FB"
      description: "\u5F53\u67D0\u4E2A\u5355\u4F4D\u7684\u653B\u51FB\u51FB\u4E2D\u654C\u4EBA\uFF0C\u4E14\u8BE5\u654C\u4EBA\u6240\u5728\u4F4D\u7F6E\u4E0E\u53CB\u65B9\u8FD1\u6218\u653B\u51FB\u8303\u56F4\u91CD\u53E0\uFF0C\u5373\u53EF\u89E6\u53D1<b>\u8FDE\u9501\u653B\u51FB</b>\u3002\u901A\u8FC7\u67D0\u4E9B\u65B9\u6CD5\uFF0C\u4E5F\u53EF\u8D4B\u4E88\u89D2\u8272\u989D\u5916\u7684\u8FDE\u9501\u653B\u51FB\u80FD\u529B\u3002"
  - triggerLevelName: PR3-4BATTLE
    pages:
    - image: {fileID: 21300000, guid: 87e8a6bda9bac4e42961082aea493db3, type: 3}
      title: "\u573A\u666F\u4EA4\u4E92"
      description: "\u573A\u666F\u4E2D\u5B58\u5728\u90E8\u5206\u53EF\u4EE5\u4EA4\u4E92\u7684\u5143\u7D20\uFF0C\u5C06\u9F20\u6807\u60AC\u505C\u5728\u8BE5\u7269\u4F53\u4E0A\u65B9\uFF0C\u4F1A\u51FA\u73B0\u9AD8\u4EAE\u63D0\u793A\u3002"
    - image: {fileID: 21300000, guid: 7067b2b05b91bb247bd23be4691b4a59, type: 3}
      title: "\u573A\u666F\u4EA4\u4E92"
      description: "\u5F53\u73A9\u5BB6\u63A5\u8FD1\u6B64\u7C7B\u7269\u4F53\uFF08\u5982\u95E8\u3001\u697C\u68AF\u7B49\uFF09\uFF0C\u5373\u53EF\u6D88\u80171\u884C\u52A8\u70B9\u4E0E\u5176\u4EA4\u4E92\u3002"
