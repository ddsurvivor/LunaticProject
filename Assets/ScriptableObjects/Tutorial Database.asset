  allTutorials:
  - triggerLevelName: PR1-2BATTLE
    pages:
    - image: {fileID: 21300000, guid: b4fcbfef11986444495d10a07663eb0c, type: 3}
      title: "\u6218\u6597\u57FA\u7840"
      description: "\u4F7F\u7528\u9F20\u6807\u5DE6\u952E\u9009\u4E2D\u4EBA\u7269\uFF0C\u5728\u89D2\u8272\u53F3\u4FA7\u7684\u9009\u9879\u680F\u9009\u62E9\u64CD\u4F5C\u5E76\u70B9\u51FB\u9F20\u6807\u5DE6\u952E\u6267\u884C\u3002"
    - image: {fileID: 21300000, guid: 53fba21598f659a45ae444a27f622359, type: 3}
      title: "\u6218\u6597\u57FA\u7840"
      description: "\u5F53\u666E\u901A\u653B\u51FB\u6216\u5DF1\u65B9\u627F\u53D7\u4F24\u5BB3\u5230\u4E00\u5B9A\u7A0B\u5EA6\uFF0C\u5373\u53EF\u89E6\u53D1\u201C\u805A\u80FD\u201D\u3002\u4F7F\u7528\u201C\u805A\u80FD\u201D\u4F1A\u4E3A\u6211\u65B9\u961F\u4F0D\u63D0\u4F9B\u989D\u5916\u7684\u56DE\u5408\u2014\u2014\u5728\u8BE5\u56DE\u5408\u4E2D\uFF0C\u654C\u4EBA\u65E0\u6CD5\u95EA\u907F\u653B\u51FB\uFF0C\u4E14\u9488\u5BF9\u540C\u4E00\u4E2A\u5355\u4F4D\u7684\u653B\u51FB\u4F1A\u6709\u53E0\u52A0\u6548\u5E94\u2014\u2014\u5728\u906D\u9047\u5371\u673A\u6216\u96BE\u4EE5\u8FC7\u5173\u65F6\uFF0C\u4E0D\u59A8\u5C1D\u8BD5\u7528\u201C\u805A\u80FD\u201D\u8131\u56F0\u3002"
    - image: {fileID: 21300000, guid: 25fb7d30962ba3149bfc54d1cd2053b1, type: 3}
      title: "\u67E5\u770B\u80CC\u5305"
      description: "\u6218\u6597\u4E2D\u70B9\u51FB\u53F3\u4E0B\u89D2\u7684\u80CC\u5305\u6309\u94AE\uFF0C\u5373\u53EF\u67E5\u770B\u5F53\u524D\u6301\u6709\u7684\u9053\u5177\u3002\u5982\u9700\u4F7F\u7528\u9053\u5177\uFF0C\u53EF\u9F20\u6807\u5DE6\u952E\u70B9\u51FB\u89D2\u8272\uFF0C\u5728\u201C\u9053\u5177\u201D\u9009\u9879\u6267\u884C\u2014\u2014\u6CE8\u610F\uFF1A\u4F7F\u7528\u9053\u5177\u4F1A\u6D88\u8017\u89D2\u8272\u884C\u52A8\u70B9\uFF0C\u8BF7\u59A5\u5584\u5B89\u6392\u3002"
  - triggerLevelName: PRBossFight
    pages:
    - image: {fileID: 21300000, guid: 6fc7d213bba3cf048b06122e58884720, type: 3}
      title: "\u8F68\u9053\u652F\u63F4"
      description: "\u5728\u7279\u5B9A\u60C5\u51B5\u4E0B\uFF0C\u6211\u65B9\u961F\u4F0D\u80FD\u4F7F\u7528\u8F68\u9053\u652F\u63F4\uFF0C\u901A\u8FC7\u589E\u63F4\u98DE\u8239\u7684\u706B\u529B\u653B\u51FB\u654C\u4EBA\uFF0C\u4EE5\u9020\u6210\u4EBA\u529B\u96BE\u4EE5\u4F01\u53CA\u7684\u4F24\u5BB3\u3002"
    - image: {fileID: 21300000, guid: f9f8bcb5b3385374995e0d9fcce8980e, type: 3}
      title: "\u8F68\u9053\u652F\u63F4"
      description: "\u5728\u89D2\u8272\u62B5\u8FBE\u9732\u5929\u5730\u5F62\u540E\uFF0C\u5373\u53EF\u5BF9\u654C\u4EBA\u5B9E\u65BD\u8F68\u9053\u652F\u63F4\u653B\u51FB\u3002\u5728\u786E\u8BA4\u6253\u51FB\u8303\u56F4\u540E\u7684\u4E0B\u4E00\u4E2A\u56DE\u5408\uFF0C\u8F68\u9053\u652F\u63F4\u4F1A\u5728\u654C\u65B9\u884C\u52A8\u524D\u51FB\u4E2D\u8303\u56F4\u5185\u7684\u76EE\u6807\u3002"
    - image: {fileID: 21300000, guid: 6fc7d213bba3cf048b06122e58884720, type: 3}
      title: "\u8F68\u9053\u652F\u63F4"
      description: "\u6CE8\u610F\uFF0C\u8F68\u9053\u652F\u63F4\u65E0\u6CD5\u8FDE\u7EED\u53D1\u52A8\uFF0C\u9700\u8981\u7B49\u5F85\u652F\u63F4\u5355\u4F4D\u5B8C\u6210\u4E0B\u4E00\u8F6E\u653B\u51FB\u7684\u51C6\u5907\u3002\u5207\u52FF\u5728\u6253\u51FB\u53D1\u52A8\u524D\u8BA9\u53CB\u65B9\u5355\u4F4D\u7559\u5728\u6253\u51FB\u8303\u56F4\u5185\uFF0C\u5426\u5219\uFF0C\u6211\u65B9\u4E5F\u4F1A\u627F\u53D7\u540C\u6837\u7684\u4F24\u5BB3\u3002"
